# Square API credentials
# Get these from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key_here

# 'sandbox' for testing, 'production' for live orders
SQUARE_ENVIRONMENT=production

# Square webhook endpoint — must be the full public HTTPS URL
WEBHOOK_URL=https://kitchen.prizmcoffee.com/webhook/square

# Password to log in to the kitchen display (shared among all baristas)
APP_PASSWORD=coffee123

# Secret key for signing sessions — use a long random string, keep it private
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Port — Railway sets this automatically, do not change
PORT=3000
