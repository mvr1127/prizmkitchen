# Square API credentials
# Get these from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key_here

# 'sandbox' for testing, 'production' for live
SQUARE_ENVIRONMENT=sandbox

# The full public URL where Square will send webhooks
# For local testing use ngrok: https://abc123.ngrok.io/webhook/square
# For production: https://yourdomain.com/webhook/square
WEBHOOK_URL=https://your-domain.com/webhook/square

# Password to log in to the kitchen display (shared among all baristas)
APP_PASSWORD=coffee123

# Secret key for signing sessions (change this to a long random string)
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Port to run the server on
PORT=3000
